/* Menu styles */
QMenuBar {
    background: transparent;
    color: #e8e8e8;
    padding: 4px 8px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #1d90f4;
    color: #ffffff;
}
QMenu {
    background: #0a0e17;
    color: #e8e8e8;
    border: 1px solid #1a2333;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}

/* Main styles */
QMainWindow, QWidget#appRoot {
    background: #070b13;
    color: #ffffff;
    font-size: 14px;
}
QWidget#contentPanel {
    background: #0e1320;
    border-radius: 14px;
}
QWidget#sidebar {
    background: #0a0e17;
    border-radius: 14px;
}
QLabel#appTitle {
    color: #ffffff;
    font-size: 23px;
    font-weight: 800;
    padding: 4px 2px 8px 2px;
}
QLabel#sidebarCaption, QLabel#libraryPath, QLabel#statusLabel, QLabel#volumeLabel {
    color: #b3b3b3;
}
QLabel#volumeLabel {
    font-size: 11px;
    padding-right: 2px;
}
QLabel#sidebarCaption {
    color: #627284;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding-left: 2px;
    margin-top: 6px;
    margin-bottom: 2px;
}
QSplitter::handle:horizontal {
    background: #141b29;
    width: 5px;
    margin: 4px 1px;
    border-radius: 2px;
}
QSplitter::handle:horizontal:hover {
    background: #1d90f4;
}

QLabel#libraryPath {
    padding-left: 4px;
    font-size: 12px;
}
QLabel#nowPlaying {
    color: #ffffff;
    font-size: 15px;
    font-weight: 650;
}
QLabel#bottomCover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #303030, stop:1 #181818);
    border-radius: 10px;
    color: #d7d7d7;
    font-size: 28px;
    font-weight: 900;
}
QLabel#bottomTitle {
    color: #ffffff;
    font-size: 10px;
    font-weight: 760;
}
QLabel#bottomArtist, QLabel#timeLabel {
    color: #a7a7a7;
    font-size: 10px;
    font-weight: 550;
}
QFrame#heroPanel {
    background: transparent;
    border: none;
    border-radius: 14px;
}
QFrame#coverArt {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1d90f4, stop:0.56 #2f2f2f, stop:1 #080808);
    border-radius: 14px;
    border: 1px solid #4f5a6b;
}
QLabel#coverIcon {
    color: #ffffff;
    font-size: 48px;
    font-weight: 900;
}
QLabel#coverWave {
    color: #d7d7d7;
    font-size: 16px;
    font-weight: 800;
}
QLabel#heroCaption {
    color: #00a8ff;
    font-size: 12px;
    font-weight: 800;
}
QLabel#heroTitle {
    color: #ffffff;
    font-size: 38px;
    font-weight: 900;
}
QLabel#heroSubtitle {
    color: #d4d4d4;
    font-size: 14px;
}
QLabel#newTracksNotification {
    background: rgba(29, 144, 244, 0.10);
    border: 1px solid rgba(29, 144, 244, 0.28);
    border-radius: 12px;
    color: #7dcfff;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 14px;
    line-height: 1.6;
}
QLineEdit {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    color: #ffffff;
    padding: 8px 14px;
    min-height: 18px;
    selection-background-color: #1d90f4;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1px solid #1d90f4;
    background: rgba(255, 255, 255, 0.09);
}
QLineEdit::placeholder {
    color: #728296;
}
QPushButton#navButton {
    background: transparent;
    color: #a0aab8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 11px 8px;
    font-size: 14px;
    font-weight: 700;
    text-align: left;
    margin: 2px 2px;
}
QPushButton#navButton:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}
QPushButton#languageButton {
    background: #161f2e;
    color: #ffffff;
    border: 1px solid #2a3a52;
    border-radius: 12px;
    padding: 5px 10px;
    min-width: 30px;
    min-height: 20px;
    font-size: 11px;
    font-weight: 850;
}
QPushButton#languageButton:hover {
    background: #202d42;
    border-color: #3b5170;
}
QListWidget {
    background: transparent;
    border: none;
    outline: 0;
    color: #a0aab8;
}
QListWidget::item {
    padding: 10px 8px;
    border-radius: 8px;
    margin: 2px 2px;
}
QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}
QListWidget::item:selected {
    background: rgba(29, 144, 244, 0.15);
    color: #00a8ff;
    font-weight: 750;
}
QTableWidget#playlistTable {
    background: transparent;
    alternate-background-color: rgba(255, 255, 255, 8);
    border: none;
    border-radius: 12px;
    color: #e8e8e8;
    outline: 0;
    selection-background-color: rgba(255, 255, 255, 24);
    selection-color: #ffffff;
}
QTableWidget#playlistTable::item {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 12);
}
QTableWidget#playlistTable::item:hover {
    background: rgba(255, 255, 255, 18);
}
QTableWidget#playlistTable::item:selected {
    background: rgba(255, 255, 255, 30);
}
QWidget#trackTitleCell {
    background: transparent;
}
QLabel#trackTitleCover {
    border-radius: 8px;
    background: #282828;
}
QLabel#trackTitleText {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
}
QLabel#trackSubtitleText {
    color: #a7a7a7;
    font-size: 11px;
    font-weight: 600;
}
QHeaderView::section {
    background: transparent;
    color: #b3b3b3;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 20);
    padding: 10px;
    font-size: 12px;
    font-weight: 700;
}
QSplitter::handle {
    background: transparent;
    width: 6px;
}
QSplitter::handle:hover {
    background: rgba(29, 144, 244, 0.3);
}
QFrame#playerBar {
    background: #080c14;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: none;
    border-left: none;
    border-right: none;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}
QLabel#bottomCover {
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
}
QLabel#bottomTitle {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}
QLabel#bottomArtist {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    font-weight: 400;
}
QLabel#timeLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-weight: 500;
    font-family: monospace, sans-serif;
}
QWidget#nowPlayingWindow {
    background: #1b2a3a;
    color: #ffffff;
}
QLabel#miniTitle {
    color: #1d90f4;
    font-size: 13px;
    font-weight: 800;
}
QWidget#discWidget {
    background: transparent;
}
QLabel#miniSong {
    color: #ffffff;
    font-weight: 900;
}
QLabel#miniArtist {
    color: #bdbdbd;
    font-weight: 650;
}
QLabel#miniTimeLabel {
    color: #d2d2d2;
    font-size: 13px;
    font-weight: 650;
}
QToolButton#miniControlButton {
    background: rgba(255, 255, 255, 34);
    border: none;
    border-radius: 22px;
    color: #ffffff;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}
QToolButton#miniControlButton:hover {
    background: rgba(255, 255, 255, 58);
}
QToolButton#miniControlButton:checked {
    background: rgba(29, 144, 244, 82);
    color: #8dd7ff;
}
QToolButton#miniPlayButton {
    background: rgba(255, 255, 255, 42);
    border: none;
    border-radius: 27px;
    color: #ffffff;
    min-width: 54px;
    max-width: 54px;
    min-height: 54px;
    max-height: 54px;
    padding: 0px;
}
QToolButton#miniPlayButton:hover {
    background: rgba(255, 255, 255, 70);
}
QToolButton#playerButton {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 0px;
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    font-size: 19px;
    font-weight: 600;
}
QToolButton#playerButton::menu-indicator {
    image: none;
}
QToolButton#playerButton:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.30);
    color: #ffffff;
}
QToolButton#playerButton:checked {
    color: #1d90f4;
    background: rgba(29, 144, 244, 0.25);
    border-color: rgba(29, 144, 244, 0.55);
}
QToolButton#playerButton:pressed {
    background: rgba(255, 255, 255, 0.22);
}



QToolButton#navRoundButton {
    background: #090909;
    color: #ffffff;
    border: none;
    border-radius: 24px;
    min-width: 36px;
    min-height: 36px;
    padding: 7px;
    font-size: 24px;
    font-weight: 800;
}
QToolButton#navRoundButton:hover {
    background: #242424;
}
QToolButton#playCircleButton {
    background: #ffffff;
    border: none;
    border-radius: 16px;
    min-width: 32px;
    min-height: 32px;
    padding: 6px;
}
QToolButton#playCircleButton:hover {
    background: #00a8ff;
}
QPushButton#shuffleButton {
    background: transparent;
    color: #b3b3b3;
    border: none;
    border-radius: 18px;
    padding: 6px 8px;
    font-weight: 650;
}
QPushButton#shuffleButton:hover {
    color: #ffffff;
    background: #242424;
}
QPushButton#shuffleButton:checked {
    background: #122538;
    color: #00a8ff;
}
QPushButton#primaryButton {
    background: #1d90f4;
    color: #ffffff;
    border: 1px solid #1d90f4;
    border-radius: 20px;
    padding: 10px 18px;
    min-height: 20px;
    font-weight: 850;
}
QPushButton#primaryButton:hover {
    background: #31a2f4;
    border-color: #31a2f4;
}
QPushButton#secondaryButton {
    background: #161f2e;
    color: #ffffff;
    border: 1px solid #2a3a52;
    border-radius: 20px;
    padding: 10px 18px;
    min-height: 20px;
    font-weight: 750;
}
QPushButton#secondaryButton:hover {
    background: #202d42;
    border-color: #3b5170;
}
QSlider#volumeSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
}
QSlider#volumeSlider::sub-page:horizontal {
    background: #38bdf8;
    height: 4px;
    border-radius: 2px;
}
QSlider#volumeSlider::add-page:horizontal {
    background: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
}
QSlider#volumeSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #38bdf8;
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.25);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.25);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
